# Copy to `.env` (never commit `.env`).
# Supabase → Project Settings → API Keys. Use the *publishable* key only:
# it's designed to ship inside the app and is safe because every table is
# protected by row level security. NEVER put a secret / service_role key here —
# anything prefixed EXPO_PUBLIC_ is bundled into the app binary.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
