{
  "expo": {
    "name": "Simul",
    "slug": "simul",
    "scheme": "simul",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simul.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.simul.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6bb290"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Simul uses your photos to set your profile picture.",
          "cameraPermission": "Simul uses your camera to take a profile picture."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "owner": "franco-galluzzo"
  }
}
